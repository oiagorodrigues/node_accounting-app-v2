{
  "name": "node_accounting-app",
  "version": "1.0.0",
  "description": "Node.js accounting app",
  "main": "src/index.js",
  "scripts": {
    "init": "mate-scripts init",
    "start": "node src/main.js",
    "dev": "node --watch src/main.js",
    "lint": "npm run format && mate-scripts lint",
    "format": "prettier --ignore-path .prettierignore --write './src/**/*.{js,ts}'",
    "test:only": "mate-scripts test",
    "update": "mate-scripts update",
    "test": "npm run lint && npm run test:only"
  },
  "author": "Mate academy",
  "license": "GPL-3.0",
  "dependencies": {
    "bcrypt": "6.0.0",
    "close-with-grace": "2.5.0",
    "cookie-parser": "1.4.7",
    "cors": "^2.8.5",
    "dotenv": "17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "9.0.3",
    "nodemailer": "9.0.3",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@mate-academy/eslint-config": "latest",
    "@mate-academy/scripts": "0.9.9",
    "@types/bcrypt": "6.0.0",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/pg": "8.20.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^28.6.0",
    "eslint-plugin-node": "^11.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0"
  },
  "mateAcademy": {
    "projectType": "javascript"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ]
  }
}
